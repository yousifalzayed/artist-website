---
layout: base.njk
---
{% set listingUrl = '/performances/' if category == 'performance' else '/' %}
{% set listingLabel = 'Performances' if category == 'performance' else 'Selected Works' %}
<article class="project-page">
  <a class="back" href="{{ listingUrl | url }}">← {{ listingLabel }}</a>
  <div class="project-intro">
    <div><h1>{{ title }}</h1><p class="meta">{{ year }}{% if exhibition %} · {{ exhibition | escape }}{% endif %}{% if medium %} · {{ medium }}{% endif %}</p>{% if materials %}<p class="meta">{{ materials | escape }}</p>{% endif %}</div>
    <div class="prose">{{ content | safe }}{% if links.length %}<ul class="project-links">{% for link in links %}<li><a href="{{ link.url | escape }}">{{ link.label | escape }} ↗</a></li>{% endfor %}</ul>{% endif %}</div>
  </div>
  {% if video %}
  {% set player = video | videoEmbed(videoAutoplay, videoLoop) %}
  <section class="performance-video" aria-label="{{ title | escape }} video">
    <div class="video-frame">
      <iframe src="{{ player.src | escape }}" title="{{ title | escape }} — {{ player.provider }} player" allow="autoplay; fullscreen; picture-in-picture; encrypted-media" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
    <p class="video-link"><a href="{{ player.url | escape }}">Watch on {{ player.provider }} ↗</a></p>
  </section>
  {% endif %}
  {% if localVideo and not mediaGallery %}
  <section class="performance-video" aria-label="{{ title | escape }} video documentation">
    <video controls playsinline preload="metadata" width="{{ localVideoWidth }}" height="{{ localVideoHeight }}" aria-label="{{ title | escape }} video documentation" style="display:block;width:auto;height:auto;max-width:100%;max-height:70vh;margin:0 auto">
      <source src="{{ (page.url + localVideo) | url }}" type="video/mp4">
      <a href="{{ (page.url + localVideo) | url }}">Watch video documentation</a>
    </video>
  </section>
  {% endif %}
  <div class="gallery">
  {% if mediaGallery %}
    <div class="gallery-row gallery-media-row" style="--gallery-columns: {{ mediaColumns }}; --gallery-width: 1080px; --portrait-columns: {{ mediaPortraitColumns }}">
    {% for image in mediaGallery %}
      <figure class="gallery-media-{{ image.kind }}">
      {% if image.kind == 'video' %}
        <video controls playsinline preload="metadata" width="{{ image.width }}" height="{{ image.height }}" aria-label="{{ image.alt | escape }}">
          <source src="{{ (page.url + image.src) | url }}" type="video/mp4">
          <a href="{{ (page.url + image.src) | url }}">Watch video documentation</a>
        </video>
      {% else %}
        <a href="{{ (page.url + image.src) | url }}"><img src="{{ (page.url + image.src) | url }}" alt="{{ image.alt | escape }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy"></a>
      {% endif %}
      </figure>
    {% endfor %}
    </div>
  {% else %}
  {% for row in gallery | galleryRows(page.inputPath, galleryWidth) %}
    <div class="gallery-row gallery-row--{{ row.orientation }}" style="--gallery-columns: {{ row.columns }}; --gallery-width: {{ row.maxWidth }}px">
    {% for image in row.images %}<figure><a href="{{ (page.url + image.src) | url }}"><img src="{{ (page.url + image.src) | url }}" alt="{{ image.alt | escape }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy"></a>{% if image.caption %}<figcaption>{{ image.caption }}</figcaption>{% endif %}</figure>{% endfor %}
    </div>
  {% endfor %}
  {% endif %}
  </div>
  <a class="back end" href="{{ listingUrl | url }}">← All {{ listingLabel | lower }}</a>
</article>
